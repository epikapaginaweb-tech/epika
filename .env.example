# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca la expongas con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (para SEO y enlaces al compartir)
NEXT_PUBLIC_SITE_URL=https://epika.education

# Acceso al panel /admin
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Cadena aleatoria de 32+ caracteres: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Aviso por correo de nuevas solicitudes (opcional, vía Resend)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=Épika Academy <avisos@epika.education>
